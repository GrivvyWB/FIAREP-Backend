{
  "expo": {
    "name": "FIAREP",
    "slug": "construction-pm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "deploymentTarget": "16.4",
      "bundleIdentifier": "com.fiarep.app",
      "buildNumber": "37",
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos of rooms and areas for estimates.",
        "NSPhotoLibraryUsageDescription": "Attach existing photos to estimates.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Face ID approves Command Center actions before they run.",
        "NSLocationWhenInUseUsageDescription": "Tag inspections and photos with their location for accurate field records.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "While you are clocked in, FIAREP records the places you work so your hours and job sites match.",
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ],
      "package": "com.tmstni.constructionpm"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach existing photos to estimates.",
          "cameraPermission": "Take photos of rooms and areas for estimates."
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "While you are clocked in, FIAREP records the places you work so your hours and job sites match."
        }
      ]
    ],
    "scheme": "constructionpm",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "71885a4c-86b2-4365-97eb-1284b85a3218"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/71885a4c-86b2-4365-97eb-1284b85a3218",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
