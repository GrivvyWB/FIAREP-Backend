export type Unit = 'each' | 'sqft' | 'lnft' | 'sq' | 'flat';
export type Category =
  | 'Drywall' | 'Electrical' | 'Plumbing' | 'Roofing'
  | 'Doors' | 'HVAC' | 'Repair' | 'Other';

export type LineItem = {
  id: string;
  category: Category;
  description: string;
  quantity: number;
  unit: Unit;
  unitPrice: number;
};

export const CATEGORIES: Category[] = ['Drywall', 'Electrical', 'Plumbing', 'Roofing', 'Doors', 'HVAC', 'Repair', 'Other'];

export const UNIT_LABEL: Record<Unit, string> = {
  each: 'each', sqft: 'sq ft', lnft: 'linear ft', sq: 'square', flat: 'flat',
};

export type Preset = { category: Category; description: string; unit: Unit; unitPrice: number };

